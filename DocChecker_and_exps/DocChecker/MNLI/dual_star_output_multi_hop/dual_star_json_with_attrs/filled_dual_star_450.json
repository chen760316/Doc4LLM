                        "start": 1320,
                        "end": 1420
                    },
                    "doc_index": 25,
                    "source_id": "Index_25",
                    "source_domain": "Unknown"
                },
                "I used to play for my college basketball team.": {
                    "text_span": {
                        "start": 2668,
                        "end": 2768
                    },
                    "doc_index": 350,
                    "source_id": "Index_350",
                    "source_domain": "Unknown"
                },
                "I am an engineer working nights because of the cutbacks and everything.": {
                    "text_span": {
                        "start": 4060,
                        "end": 4160
                    },
                    "doc_index": 449,
                    "source_id": "Index_449",
                    "source_domain": "Unknown"
                },
                "The woman on the altar was cut open.": {
                    "method": "slow precision",
                    "text_span": {
                        "start": 2664,
                        "end": 2764
                    },
                    "doc_index": 263,
                    "source_id": "Index_263",
                    "source_domain": "Unknown"
                },
                "Even if my opinion were God's law, that wouldn't have stopped the angry Little League parents from going after him.": {
                    "text_span": {
                        "start": 3819,
                        "end": 3934
                    },
                    "doc_index": 307,
                    "source_id": "Index_307",
                    "source_domain": "Unknown"
                },
                "I pointed at the joint between carriages.": {
                    "description": "the two cops had melted it half away",
                    "text_span": {
                        "start": 3120,
                        "end": 3220
                    },
                    "doc_index": 350,
                    "source_id": "Index_350",
                    "source_domain": "Unknown"
                },
                "The woman voted nay on the minimum-wage bill despite the fact that 60 percent of people working at minimum wage are women.": {
                    "text_span": {
                        "start": 3904,
                        "end": 4026
                    },
                    "doc_index": 236,
                    "source_id": "Index_236",
                    "source_domain": "Unknown"
                },
                "I have a huge distributor ship.": {
                    "text_span": {
                        "start": 2640,
                        "end": 2740
                    },
                    "doc_index": 9,
                    "source_id": "Index_9",
                    "source_domain": "Unknown"
                },
                "I am done where I work.": {
