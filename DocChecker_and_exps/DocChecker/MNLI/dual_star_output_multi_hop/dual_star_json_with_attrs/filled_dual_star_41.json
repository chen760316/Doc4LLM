                        "start": 441,
                        "end": 567
                    },
                    "doc_index": 429,
                    "source_id": "Index_429",
                    "source_domain": "Unknown"
                },
                "You are talking about farming.": {
                    "text_span": {
                        "start": 2685,
                        "end": 2785
                    },
                    "doc_index": 434,
                    "source_id": "Index_434",
                    "source_domain": "Unknown"
                },
                "You usually do not stay in one place very long when with a group of people.": {
                    "text_span": {
                        "start": 777,
                        "end": 877
                    },
                    "doc_index": 165,
                    "source_id": "Index_165",
                    "source_domain": "Unknown"
                },
                "The government used private speakers to transmit information pertaining to its own program.": {
                    "text_span": {
                        "start": 1125,
                        "end": 1225
                    },
                    "doc_index": 386,
                    "source_id": "Index_386",
                    "source_domain": "Unknown"
                },
                "You will have enough money available for him to attend a state college.": {
                    "text_span": {
                        "start": 2520,
                        "end": 2620
                    },
                    "doc_index": 80,
                    "source_id": "Index_80",
                    "source_domain": "Unknown"
                },
                "You pulled the ball away.": {
                    "text_span": {
                        "start": 228,
                        "end": 328
                    },
                    "doc_index": 347,
                    "source_id": "Index_347",
                    "source_domain": "Unknown"
                },
                "You represent the government in discussions.": {
                    "text_span": {
                        "start": 3762,
                        "end": 3862
                    },
                    "doc_index": 109,
                    "source_id": "Index_109",
                    "source_domain": "Unknown"
                },
                "You are still learning about the complex machines.": {
                    "text_span": {
                        "start": 2025,
                        "end": 2125
                    },
                    "doc_index": 191,
                    "source_id": "Index_191",
                    "source_domain": "Unknown"
                },
                "You have the right, and judges do not observe that.": {
                    "text_span": {
                        "start": 3675,
                        "end": 3763
                    },
                    "doc_index": 4,
                    "source_id": "Index_4",
                    "source_domain": "Unknown"
                },
                "You want to change the world.": {
                    "text_span": {
                        "start": 2254,
                        "end": 2354
                    },
                    "doc_index": 434,
                    "source_id": "Index_434",
                    "source_domain": "Unknown"
                },
                "You know about the new government in a third world country.": {
                    "status": "brand new",
                    "text_span": {
                        "start": 3799,
                        "end": 3899
                    },
                    "doc_index": 109,
                    "source_id": "Index_109",
                    "source_domain": "Unknown"
                },
                "You have been to Kentucky.": {
                    "text_span": {
                        "start": 2119,
                        "end": 2139
                    },
                    "doc_index": 165,
                    "source_id": "Index_165",
                    "source_domain": "Unknown"
                },
                "You bought a power roller.": {
                    "from": "Home Depot",
                    "text_span": {
                        "start": 4342,
                        "end": 4427
                    },
                    "doc_index": 431,
                    "source_id": "Index_431",
                    "source_domain": "Unknown"
                },
                "You wish someone tons of luck in their graduate school next year.": {
                    "text_span": {
                        "start": 3200,
                        "end": 3245
                    },
                    "doc_index": 347,
                    "source_id": "Index_347",
                    "source_domain": "Unknown"
                },
                "You let him kick the ball.": {
                    "text_span": {
                        "start": 78,
                        "end": 178
                    },
                    "doc_index": 347,
                    "source_id": "Index_347",
                    "source_domain": "Unknown"
                },
                "The government has gone against a small company.": {
                    "text_span": {
                        "start": 1128,
                        "end": 1228
                    },
                    "doc_index": 252,
                    "source_id": "Index_252",
                    "source_domain": "Unknown"
                },
                "The government cannot change their mind after the fiscal report is finalized.": {
                    "text_span": {
                        "start": 190,
                        "end": 290
                    },
                    "doc_index": 353,
                    "source_id": "Index_353",
                    "source_domain": "Unknown"
                },
                "You live very far from the city.": {
                    "text_span": {
                        "start": 80,
                        "end": 180
                    },
                    "doc_index": 354,
                    "source_id": "Index_354",
                    "source_domain": "Unknown"
                },
                "The machines consist of many different and connected parts.": {
                    "text_span": {
                        "start": 2204,
                        "end": 2304
                    },
                    "doc_index": 191,
                    "source_id": "Index_191",
                    "source_domain": "Unknown"
                },
                "You have one of those stickers in Brian's room.": {
                    "text_span": {
                        "start": 529,
                        "end": 629
                    },
                    "doc_index": 347,
                    "source_id": "Index_347",
                    "source_domain": "Unknown"
                },
                "You can watch the National Geographic ones several times.": {
                    "text_span": {
                        "start": 3360,
                        "end": 3460
                    },
                    "doc_index": 235,
                    "source_id": "Index_235",
                    "source_domain": "Unknown"
                },
                "If he wants to go to a private college, he can get a scholarship.": {
                    "text_span": {
                        "start": 2656,
                        "end": 2756
                    },
                    "doc_index": 80,
                    "source_id": "Index_80",
                    "source_domain": "Unknown"
                },
                "You don't remember if it was Raleigh and Saint Augustine or what.": {
                    "text_span": {
                        "start": 3648,
                        "end": 3748
                    },
                    "doc_index": 191,
                    "source_id": "Index_191",
                    "source_domain": "Unknown"
                },
                "You have been to Montana.": {
                    "text_span": {
                        "start": 2112,
                        "end": 2139
                    },
                    "doc_index": 165,
                    "source_id": "Index_165",
                    "source_domain": "Unknown"
                },
                "There is a strong military presence in the city and a curfew is often in effect.": {
                    "text_span": {
                        "start": 1200,
                        "end": 1300
                    },
                    "doc_index": 355,
                    "source_id": "Index_355",
                    "source_domain": "Unknown"
                },
                "You are responsible for the death of my friend.": {
                    "text_span": {
                        "start": 69,
                        "end": 169
                    },
                    "doc_index": 235,
                    "source_id": "Index_235",
                    "source_domain": "Unknown"
                },
                "You have been to Wyoming.": {
                    "text_span": {
                        "start": 576,
                        "end": 676
                    },
                    "doc_index": 165,
                    "source_id": "Index_165",
                    "source_domain": "Unknown"
                },
                "You wanted to make sure all the items were being tracked.": {
                    "text_span": {
                        "start": 2884,
                        "end": 2984
                    },
                    "doc_index": 316,
                    "source_id": "Index_316",
                    "source_domain": "Unknown"
                },
                "You will receive a discount if you subscribe online.": {
                    "text_span": {
                        "start": 3432,
                        "end": 3532
                    },
                    "doc_index": 434,
                    "source_id": "Index_434",
                    "source_domain": "Unknown"
                },
                "Have you ever owned your own home?": {
                    "text_span": {
                        "start": 2669,
                        "end": 2769
                    },
                    "doc_index": 140,
                    "source_id": "Index_140",
                    "source_domain": "Unknown"
                }
            }
        }
