            "multi_hop_edges_attrs": {
                "The ability to leverage other funds to represent LSC eligible clients is a factor LSC considers in evaluating its grantees.": {
                    "text_span": {
                        "start": 0,
                        "end": 123
                    },
                    "doc_index": 330,
                    "source_id": "Index_330",
                    "source_domain": "Unknown"
                },
                "David Hall stated that LSC does not encourage grantees to seek more funds.": {
                    "text_span": {
                        "start": 518,
                        "end": 618
                    },
                    "doc_index": 110,
                    "source_id": "Index_110",
                    "source_domain": "Unknown"
                },
                "LSC encourages all its grantees to obtain other funding for the client community.": {
                    "reason": "to obtain other funding",
                    "text_span": {
                        "start": 240,
                        "end": 340
                    },
                    "doc_index": 110,
                    "source_id": "Index_110",
                    "source_domain": "Unknown"
                },
                "The LSC diversity message was delivered locally in states like Arizona and Montana.": {
                    "method": "Articles",
                    "source": "MIE Journal and NLADA Update",
                    "text_span": {
                        "start": 3034,
                        "end": 3134
                    },
                    "doc_index": 256,
                    "source_id": "Index_256",
                    "source_domain": "Unknown"
                },
                "Congress did not intend to imply a private cause of action by CCLS to challenge the LSC's exercise of its statutory and regulatory duties.": {
                    "text_span": {
                        "start": 2553,
                        "end": 2691
                    },
                    "doc_index": 82,
                    "source_id": "Index_82",
                    "source_domain": "Unknown"
                },
                "LSC continued to offer technical assistance to lower funded states to increase resources.": {
                    "type": "technical assistance",
                    "text_span": {
                        "start": 484,
                        "end": 584
                    },
                    "doc_index": 359,
                    "source_id": "Index_359",
                    "source_domain": "Unknown"
                },
                "Congress told the LSC to start using competitive bidding for its contracts.": {
                    "time": "same year",
                    "text_span": {
                        "start": 888,
                        "end": 988
                    },
                    "doc_index": 389,
                    "source_id": "Index_389",
                    "source_domain": "Unknown"
                },
                "Congress passed comprehensive sanctions against the apartheid regime in South Africa.": {
                    "time": "before the fall of communism",
                    "text_span": {
                        "start": 462,
                        "end": 562
                    },
                    "doc_index": 31,
                    "source_id": "Index_31",
                    "source_domain": "Unknown"
                },
                "Tax incentives can be used to encourage household savings.": {
                    "text_span": {
                        "start": 1218,
                        "end": 1318
                    },
                    "doc_index": 245,
                    "source_id": "Index_245",
                    "source_domain": "Unknown"
                },
                "LSC's planning team will work with DSPB.": {
                    "goal": "to foster timely and effective consideration of issues",
                    "text_span": {
                        "start": 1660,
                        "end": 1760
                    },
                    "doc_index": 316,
                    "source_id": "Index_316",
                    "source_domain": "Unknown"
                },
                "The division of powers is between the federal and state parliaments.": {
                    "text_span": {
                        "start": 1258,
                        "end": 1358
                    },
                    "doc_index": 190,
                    "source_id": "Index_190",
                    "source_domain": "Unknown"
                },
                "The Congress is availing itself of GAO's services and support.": {
                    "basis": "unprecedented and accelerating",
                    "text_span": {
                        "start": 1550,
                        "end": 1650
                    },
                    "doc_index": 307,
                    "source_id": "Index_307",
                    "source_domain": "Unknown"
                },
                "The statute was invalidated by the higher court.": {
                    "text_span": {
                        "start": 1248,
                        "end": 1348
                    },
                    "doc_index": 406,
                    "source_id": "Index_406",
                    "source_domain": "Unknown"
                },
                "Congress never reformed presumptive refunding at any time.": {
                    "text_span": {
                        "start": 3190,
                        "end": 3290
                    },
                    "doc_index": 59,
                    "source_id": "Index_59",
                    "source_domain": "Unknown"
                },
                "LSC can award grants to the best applicants without unnecessary administrative barriers.": {
                    "text_span": {
                        "start": 3212,
                        "end": 3312
                    },
                    "doc_index": 403,
                    "source_id": "Index_403",
                    "source_domain": "Unknown"
                },
                "Congress cut federal funding for certain services across the board.": {
                    "text_span": {
                        "start": 858,
                        "end": 958
                    },
                    "doc_index": 111,
                    "source_id": "Index_111",
                    "source_domain": "Unknown"
                },
                "LSC provides legal assistance and information to low-income Americans.": {
                    "text_span": {
                        "start": 420,
                        "end": 520
                    },
                    "doc_index": 219,
                    "source_id": "Index_219",
                    "source_domain": "Unknown"
                },
                "The federal government can explore how to design tax incentives.": {
                    "purpose": "induce households to save enough to make up for the government's revenue loss",
                    "text_span": {
